<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".fragments.setting.user.AuthorisationFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_btn_auth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_margin="10dp"
        >
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back_auth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:icon="@drawable/ic_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_margin="5dp"
            android:text="Назад"
            android:textSize="@dimen/text_normal"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/ll_settings_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cl_btn_auth"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tv_auth_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="30dp"
            android:textSize="@dimen/text_title"
            android:text="Вход/Регистрация"
            android:gravity="center"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/boarder">

            <Button
                android:id="@+id/btn_to_auth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Вход"
                android:background="@drawable/button_background"
                android:shadowRadius="20"
                android:textSize="@dimen/text_normal"
                />

            <Button
                android:id="@+id/btn_to_reg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Регистрация"
                android:background="@drawable/button_background"
                android:textSize="@dimen/text_normal"
                />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_auth_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="30dp"
            android:layout_marginStart="30dp">

            <TextView
                android:layout_width="@dimen/text_view_width_normal"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:textSize="@dimen/text_normal"
                android:text="Почта"
                android:gravity="center_vertical"/>

            <EditText
                android:id="@+id/et_auth_email"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:importantForAutofill="no"
                android:inputType="textEmailAddress"
                android:layout_margin="5dp"
                android:labelFor="@id/et_auth_email"
                android:textSize="@dimen/text_normal"
                />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_auth_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="30dp"
            android:layout_marginStart="30dp"
            android:visibility="visible"
            >

            <TextView
                android:layout_width="@dimen/text_view_width_normal"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:textSize="@dimen/text_normal"
                android:text="Ник"
                android:gravity="center_vertical" />

            <EditText
                android:id="@+id/et_auth_username"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_margin="5dp"
                android:importantForAutofill="no"
                android:inputType="text"
                android:textSize="@dimen/text_normal"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_auth_first_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="30dp"
            android:layout_marginStart="30dp"
            android:visibility="visible"
            >

            <TextView
                android:layout_width="@dimen/text_view_width_normal"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:textSize="@dimen/text_normal"
                android:text="Имя"
                android:gravity="center_vertical" />

            <EditText
                android:id="@+id/et_auth_first_name"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:importantForAutofill="no"
                android:layout_margin="5dp"
                android:inputType="text"
                android:textSize="@dimen/text_normal" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_auth_last_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="30dp"
            android:layout_marginStart="30dp"
            android:visibility="visible"
            >

            <TextView
                android:layout_width="@dimen/text_view_width_normal"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:textSize="@dimen/text_normal"
                android:text="Фамилия"
                android:gravity="center_vertical" />

            <EditText
                android:id="@+id/et_auth_last_name"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:importantForAutofill="no"
                android:layout_margin="5dp"
                android:inputType="text"
                android:textSize="@dimen/text_normal" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_auth_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="30dp"
            android:layout_marginStart="30dp"
            >

            <TextView
                android:layout_width="@dimen/text_view_width_normal"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:textSize="@dimen/text_normal"
                android:text="Пароль"
                android:gravity="center_vertical" />

            <EditText
                android:id="@+id/et_auth_password"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:importantForAutofill="no"
                android:layout_margin="5dp"
                android:inputType="textPassword"
                android:textSize="@dimen/text_normal" />

        </LinearLayout>

        <Button
            android:id="@+id/btn_auth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="50dp"
            android:text="Войти"
            android:textSize="18sp"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btn_registration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="50dp"
            android:text="Зарегистрироваться"
            android:textSize="@dimen/text_normal"
            android:visibility="visible"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>