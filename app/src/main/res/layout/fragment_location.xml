<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".fragments.location.LocationFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".MainActivity">

        <com.yandex.mapkit.mapview.MapView
            android:id="@+id/map_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="200dp">
        </com.yandex.mapkit.mapview.MapView>

        <androidx.cardview.widget.CardView
            android:id="@+id/location_card"
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:cardCornerRadius="180dp"
            app:layout_constraintTop_toBottomOf="@id/map_view"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/start_card"
            app:layout_constraintBottom_toTopOf="@id/radiusSize_bar">

            <Button
                android:id="@+id/location_btn"
                android:text="Я"
                android:textSize="@dimen/text_normal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="-50dp"
                android:layout_marginTop="-50dp"
                android:layout_marginEnd="-50dp"
                android:layout_marginBottom="-50dp" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/start_card"
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:cardCornerRadius="180dp"
            app:layout_constraintTop_toBottomOf="@id/map_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/location_card"
            app:layout_constraintBottom_toTopOf="@id/radiusSize_bar">

            <ImageButton
                android:id="@+id/start_btn"
                android:contentDescription="Поиск"
                android:background="@color/purple_500"
                android:src="@drawable/ic_search"
                android:textSize="18sp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="-50dp"
                android:layout_marginTop="-50dp"
                android:layout_marginEnd="-50dp"
                android:layout_marginBottom="-50dp" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/radiusSize_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@id/radiusSize_bar"
            app:layout_constraintTop_toBottomOf="@id/location_card"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:textSize="@dimen/text_normal"
            />

        <SeekBar
            android:id="@+id/radiusSize_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/radiusSize_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="50dp"
            android:layout_marginEnd="50dp"
            android:layout_marginBottom="20dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>