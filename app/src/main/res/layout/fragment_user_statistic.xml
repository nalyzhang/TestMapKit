<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".fragments.statistic.UserStatisticFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_btn_user_statistic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_margin="10dp"
        >
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back_user_statistic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:icon="@drawable/ic_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_margin="5dp"
            android:text="Назад"
            android:textSize="@dimen/text_normal"
            />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_profile_user_statistic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_margin="5dp"
            android:text="Перейти в профиль"
            android:textSize="@dimen/text_normal"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/ll_user_statistic_user_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cl_btn_user_statistic"
        android:layout_margin="20dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/cv_img_user_statistic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardElevation="5dp"
            app:cardCornerRadius="180dp"
            android:layout_margin="10dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/img_user_statistic"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:background="@color/light_blue"
                    android:contentDescription="User avatar"
                    android:src="@drawable/ic_profile"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tv_user_statistic_username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ник"
            android:textSize="@dimen/text_title"
            android:layout_margin="20dp"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_user_statistic_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/boarder"
        android:layout_margin="5dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_user_statistic_user_detail">

        <Button
            android:id="@+id/btn_user_statistic_week"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/button_background"
            android:text="Нед"
            android:textSize="@dimen/text_normal" />

        <Button
            android:id="@+id/btn_user_statistic_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Мес"
            android:background="@drawable/button_background"
            android:textSize="@dimen/text_normal"
            />

        <Button
            android:id="@+id/btn_user_statistic_year"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Год"
            android:background="@drawable/button_background"
            android:textSize="@dimen/text_normal"
            />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_user_statistic_period"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_margin="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_user_statistic_type">

        <androidx.cardview.widget.CardView
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:cardCornerRadius="180dp">

            <ImageButton
                android:id="@+id/btn_user_statistic_back_arrow"
                android:contentDescription="Назад"
                android:background="@color/purple_500"
                android:src="@drawable/ic_arrow_back"
                android:textSize="18sp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tv_user_statistic_period"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:text="dd.MM.yyy"
            android:textSize="@dimen/text_normal"
            android:gravity="center"
            android:layout_margin="15dp"
            />

        <androidx.cardview.widget.CardView
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:cardCornerRadius="180dp">

            <ImageButton
                android:id="@+id/btn_user_statistic_forward_arrow"
                android:contentDescription="Назад"
                android:background="@color/purple_500"
                android:src="@drawable/ic_arrow_forward"
                android:textSize="18sp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:cardCornerRadius="180dp">

            <ImageButton
                android:id="@+id/btn_user_statistic_today"
                android:contentDescription="Назад"
                android:background="@color/purple_500"
                android:src="@drawable/ic_today"
                android:textSize="18sp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </androidx.cardview.widget.CardView>


    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbars="vertical"
        android:fillViewport="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_user_statistic_period"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/ll_user_statistic_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_margin="20dp">


            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="30dp"
                android:layout_marginStart="30dp"
                android:textSize="@dimen/text_normal"
                android:text="Статистика прохождения маршрутов"
                android:gravity="center" />

            <com.github.mikephil.charting.charts.BarChart
                android:id="@+id/bc_statistic_count"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_margin="20dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginEnd="30dp"
                android:layout_marginStart="30dp"
                android:visibility="visible"
                >

                <TextView
                    android:layout_width="@dimen/text_view_width_extra"
                    android:layout_height="match_parent"
                    android:layout_margin="5dp"
                    android:textSize="@dimen/text_normal"
                    android:text="Количество прогулок"
                    android:gravity="center_vertical" />

                <TextView
                    android:id="@+id/tv_user_statistic_stat_count"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="5dp"
                    android:textSize="@dimen/text_normal"
                    android:text="Количество прогулок"
                    android:gravity="center_vertical" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginEnd="30dp"
                android:layout_marginStart="30dp"
                android:visibility="visible"
                >

                <TextView
                    android:layout_width="@dimen/text_view_width_extra"
                    android:layout_height="match_parent"
                    android:layout_margin="5dp"
                    android:textSize="@dimen/text_normal"
                    android:text="Количество завершеных"
                    android:gravity="center_vertical" />

                <TextView
                    android:id="@+id/tv_user_statistic_completed_count"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="5dp"
                    android:textSize="@dimen/text_normal"
                    android:text="Количество завершенных"
                    android:gravity="center_vertical" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_user_statistic_completed_per"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginEnd="30dp"
                android:layout_marginStart="30dp"
                android:visibility="visible"
                >

                <TextView
                    android:layout_width="@dimen/text_view_width_extra"
                    android:layout_height="match_parent"
                    android:layout_margin="5dp"
                    android:textSize="@dimen/text_normal"
                    android:text="% завершеных"
                    android:gravity="center_vertical" />

                <TextView
                    android:id="@+id/tv_user_statistic_completed_per"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="5dp"
                    android:textSize="@dimen/text_normal"
                    android:text="% завершенных"
                    android:gravity="center_vertical" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="30dp"
                android:layout_marginEnd="30dp"
                android:layout_marginStart="30dp"
                android:textSize="@dimen/text_normal"
                android:text="Статистика времени прохождения маршрутов"
                android:gravity="center" />

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/lc_statistic_time"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_margin="20dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="30dp"
                android:layout_marginStart="30dp"
                android:textSize="@dimen/text_normal"
                android:text="Распределение выбора радиуса поиска"
                android:gravity="center" />

            <com.github.mikephil.charting.charts.BarChart
                android:id="@+id/bc_statistic_radius"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_margin="20dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginEnd="30dp"
                android:layout_marginStart="30dp"
                android:visibility="visible"
                >

                <TextView
                    android:layout_width="@dimen/text_view_width_extra"
                    android:layout_height="match_parent"
                    android:layout_margin="5dp"
                    android:textSize="@dimen/text_normal"
                    android:text="Средний радиус"
                    android:gravity="center_vertical" />

                <TextView
                    android:id="@+id/tv_user_statistic_radius"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="5dp"
                    android:textSize="@dimen/text_normal"
                    android:text="Средний радиус"
                    android:gravity="center_vertical" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="100dp"/>



            <ProgressBar
                android:id="@+id/pb_user_statistic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>